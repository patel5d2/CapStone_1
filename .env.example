# ── Database ──
# Only needed when running the app outside Docker; the compose app service sets
# DATABASE_HOST=db itself, and application.yml defaults to these same values so
# `docker compose up -d db` then `./mvnw spring-boot:run` works with no setup.
# Flyway creates the schema on first start — see src/main/resources/db/migration/.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=changeme
DEV_DATABASE_NAME=enterprise_dev
PROD_DATABASE_NAME=enterprise_prod
# Compose creates DEV_DATABASE_NAME by default. For a fresh production stack set
# DATABASE_NAME=enterprise_prod AND SPRING_PROFILES_ACTIVE=prod. Changing this value
# does not create or rename databases in an existing Postgres volume.
# DATABASE_NAME=enterprise_prod

# ── Spring Boot ──
SPRING_PROFILES_ACTIVE=dev
JAVA_OPTS=-Xmx512m

# ── Clerk ──
# Public build-time key must belong to the same instance as the backend URLs.
# Rebuild the SPA/image after changing the publishable key or two-factor flag.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_aW5ub2NlbnQtbWFjYXctMTY4Ny5jbGVyay5hY2NvdW50cy5kZXYk
CLERK_ISSUER=https://innocent-macaw-1687.clerk.accounts.dev
CLERK_JWKS_URI=https://innocent-macaw-1687.clerk.accounts.dev/.well-known/jwks.json
# Compose forwards this to both the backend and the frontend build argument.
# Require a verified second factor for student access.
CAMPUSBRIDGE_AUTH_REQUIRE_TWO_FACTOR=true
# Signing secret of the Clerk webhook endpoint, from the dashboard (Webhooks -> your
# endpoint -> Signing Secret). Left EMPTY here on purpose: this file is committed, and a
# real "whsec_..." value in it would be a committed credential. Without it the app starts
# normally and POST /api/webhooks/clerk refuses every delivery.
CLERK_WEBHOOK_SECRET=

# ── Prometheus ──
# Disposable local value. Replace in any deployed environment.
METRICS_PASSWORD=local-metrics-change-me

# ── Grafana ──
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=changeme

# Server-side Cloudinary credentials. Never use a VITE_ variable for this secret.
CLOUDINARY_URL=

# Neon test database for the "neon" Spring profile (application-neon.yml).
# Get the pooled connection details from the Neon console or `neon connection-string`.
NEON_DB_URL=
NEON_DB_USERNAME=
NEON_DB_PASSWORD=
