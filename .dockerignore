.git
.gitignore
.github
.idea
.vscode
target/
*.png
README.md
.dockerignore
Dockerfile

# The frontend image stage installs dependencies and builds from source;
# copying a host build would be slower and could be stale.
frontend/node_modules
frontend/dist
src/main/resources/static

# A local Clerk setting must not silently override reproducible build arguments.
# Runtime credentials never belong in a Docker build context.
.env
.env.*
frontend/.env
frontend/.env.*
!.env.example
!frontend/.env.example
