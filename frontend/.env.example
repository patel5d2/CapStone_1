# Copy to .env before running `npm run dev` or `npm run build`.
#
# Clerk publishable key. Publishable keys are designed to ship to the browser;
# the matching secret key stays server-side and is never referenced here.
# This is the same Clerk instance the Spring Boot API validates tokens against,
# so it must match CLERK_ISSUER / CLERK_JWKS_URI in the backend configuration.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_aW5ub2NlbnQtbWFjYXctMTY4Ny5jbGVyay5hY2NvdW50cy5kZXYk

# Must match campusbridge.auth.require-two-factor in the backend configuration.
# Students must enroll an authenticator app before accessing the app.
VITE_REQUIRE_TWO_FACTOR=true
